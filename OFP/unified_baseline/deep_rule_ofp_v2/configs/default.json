{
  "schema_version": "fgofp-native-seq-v1",
  "experiment_name": "FGLSeq_LegacyInclusive",
  "seed": 42,
  "protocol": {
    "name": "legacy_inclusive_v1",
    "hit_condition": "first_alarm_timestamp <= first_failure_timestamp",
    "timestamp_dtype": "int64_seconds"
  },
  "task": {
    "name": "optical_module_failure_prediction",
    "student_horizon_hours": 120.0,
    "teacher_horizon_hours": 114.0,
    "future_offset_hours": 6.0,
    "include_first_failure_row": true
  },
  "split": {
    "test_fold": 3,
    "validation_fraction": 0.1,
    "seed": 42
  },
  "inputs": {
    "cadence_mode": "native_observed_rows",
    "expected_cadence_seconds": 300,
    "delta_clip_steps": 288.0,
    "alignment_tolerance_seconds": 300
  },
  "model": {
    "architecture": "causal_depthwise_tcn",
    "hidden_channels": 48,
    "dilation_blocks": 10,
    "kernel_size": 3,
    "dropout": 0.1
  },
  "training": {
    "teacher_epochs": 5,
    "student_epochs": 8,
    "batch_size": 8,
    "inference_batch_size": 8,
    "teacher_learning_rate": 0.0003,
    "student_learning_rate": 0.0003,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "fgl_alpha": 0.7,
    "temperature": 4.0,
    "positive_weight_mode": "module_normalized_auto",
    "max_positive_weight": 5.0,
    "mixed_precision": true,
    "early_stopping_patience": 2,
    "num_workers": 0,
    "device": "auto"
  },
  "decision": {
    "fixed_threshold": 0.5,
    "tune_on_validation": true,
    "threshold_grid_size": 201,
    "threshold_quantile_count": 201,
    "selection_metric": "final_score"
  }
}
